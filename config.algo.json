  "engine": {
    "mode": "auto",
    "pagesPerQuery": 3,
    "headless": true,
    "offscreenWindow": false,
    "keepSession": true,
    "navigationTimeoutMs": 25000,
    "fetchBody": true,
    "maxBodies": 40
  },

  "rate": {
    "minDelayMs": 1400,
    "jitterMs": 900,
    "perHostConcurrency": 1,
    "backoff": { "startMs": 8000, "factor": 2, "maxMs": 300000, "recoverAfterOk": 8 }
  },

  "output": {
    "dir": "./out/algo",
    "resume": false
  },

